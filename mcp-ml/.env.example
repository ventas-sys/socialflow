# Pegá acá el MISMO JSON que ya está configurado en la variable de entorno
# ML_ACCOUNTS de Vercel (mismo formato que espera lib/ml/qa-config.js).
# Ver docs/SETUP-MCP-MERCADOLIBRE.md para más detalle.
ML_ACCOUNTS=[{"label":"local","mode":"local","user_id":123456,"client_id":"...","client_secret":"...","refresh_token":"..."}]

# ⚠️ IMPORTANTE: ML rota el refresh_token en cada renovación (es de un solo uso).
# Si este MCP renueva con su propia copia, INVALIDA el token del agente de
# preguntas en Vercel y el bot deja de responder. Pegá acá las MISMAS variables
# de KV que tenés en Vercel para que compartan el token guardado.
KV_REST_API_URL=
KV_REST_API_TOKEN=
