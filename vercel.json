{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ml/cron.js": { "maxDuration": 300 },
    "api/ml/exchange.js": { "maxDuration": 300 },
    "api/ml/envios.js": { "maxDuration": 300 },
    "api/ml/saldos.js": { "maxDuration": 300 },
    "api/contabilium.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/ml/cron", "schedule": "0 16 * * *" },
    { "path": "/api/ml/cron", "schedule": "0 21 * * *" },
    { "path": "/api/ml/saldos", "schedule": "0 3 * * *" },
    { "path": "/api/ml/saldos", "schedule": "0 9 * * *" },
    { "path": "/api/ml/saldos", "schedule": "0 15 * * *" },
    { "path": "/api/ml/saldos", "schedule": "0 21 * * *" }
  ]
}
