rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador: puede todo y gestiona el equipo desde el Dashboard
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ventas@distribuidorauniverso.com';
    }

    // Miembro: el administrador o cualquier email agregado a la colección "members"
    function isMember() {
      return isAdmin() || (
        request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
      );
    }

    // Inventario compartido: todos los miembros ven y modifican lo mismo
    match /products/{id}  { allow read, write: if isMember(); }
    match /combos/{id}    { allow read, write: if isMember(); }
    match /movements/{id} { allow read, write: if isMember(); }
    match /settings/{id}  { allow read, write: if isMember(); }

    // Solo el administrador agrega o quita miembros
    match /members/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
