rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrador: puede todo y gestiona el equipo desde 👥 Usuarios
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ventas@distribuidorauniverso.com'
        || request.auth.token.email == 'cron@distribuidorauniverso.com'
      );
    }

    // Miembro: el administrador o cualquier email agregado a la colección "members"
    function isMember() {
      return isAdmin() || (
        request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
      );
    }

    // Puede MODIFICAR el inventario: el admin siempre; un ayudante solo si su
    // permiso "Puede modificar" (canEdit) no está apagado en 👥 Usuarios.
    // Sin el campo (miembros viejos) se considera permitido, igual que en la app.
    function canEdit() {
      return isAdmin() || (
        isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.get('canEdit', true) != false
      );
    }

    // Inventario compartido: todos los miembros lo VEN; lo MODIFICAN solo
    // el admin y los ayudantes con "Puede modificar"
    match /products/{id}  { allow read: if isMember(); allow write: if canEdit(); }
    match /combos/{id}    { allow read: if isMember(); allow write: if canEdit(); }
    match /movements/{id} { allow read: if isMember(); allow write: if canEdit(); }
    match /photos/{id}    { allow read: if isMember(); allow write: if canEdit(); }

    // Operación de reparto y empaquetado: la usan TODOS los miembros
    // (armar, asignar motoquero, entregar) aunque no puedan tocar el stock
    match /shipments/{id} { allow read, write: if isMember(); }
    match /couriers/{id}  { allow read, write: if isMember(); }
    // Órdenes de ML ya procesadas (para no descontar dos veces)
    match /ml_orders/{id} { allow read, write: if isMember(); }
    // Cuentas de MercadoLibre (tienen el Secret): las lee/escribe solo el admin
    match /ml_accounts/{id} { allow read, write: if isAdmin(); }
    // El mapa del depósito lo ve todo el equipo pero solo lo modifica el admin
    match /settings/{id}  { allow read: if isMember(); allow write: if isAdmin(); }

    // Solo el administrador agrega o quita miembros y cambia permisos
    match /members/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
