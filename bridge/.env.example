# URL del cerebro en Vercel
WA_WEBHOOK_URL=https://socialflow.uniproveedores.com.ar/api/wa/webhook

# Token compartido con Vercel (generar con: openssl rand -hex 32)
WA_BRIDGE_TOKEN=

# Nombre de la sesión (no cambiar después del primer arranque o hay que re-escanear QR)
WA_SESSION=uniproveedores

# Nombre (o palabra clave) de la etiqueta amarilla en WhatsApp Business
# Matchea por substring case-insensitive, así que "HUMANO 😢" es válido.
# Nota: WhatsApp migró Etiquetas a "Listas"; si el API de etiquetas deja de
# andar, el bot igual marca el chat como NO LEÍDO y avisa al supervisor.
WA_HUMAN_LABEL=HUMANO

# Número de WhatsApp del supervisor para avisos de "atención requerida"
# (reclamos, mayoristas, pedidos de hablar con una persona). Solo dígitos con
# código de país, ej: 5491122334455. Vacío = sin avisos.
WA_SUPERVISOR_NUMBER=

# Si el autodiscovery por nombre falla, copiá acá el id exacto que ves al
# arranque en pm2 logs después de "📋 Intento N: X etiqueta(s) detectada(s)".
# Vacío = autodiscovery normal.
WA_HUMAN_LABEL_ID=

# Mandar email cada vez que escribe un cliente nuevo? "true" para activar.
# Default false (no spammea). El CSV new-clients.csv se sigue guardando.
WA_NEW_CLIENT_EMAIL=false

# Cuando el asesor responde manualmente desde el celular, el bot se silencia
# para ese contacto durante estas horas (default 3). Después vuelve a actuar.
WA_HUMAN_TAKEOVER_HOURS=3

# Ventana en ms para identificar auto-reply nativo de WhatsApp Business
# (mensaje de bienvenida instantáneo). Default 3000ms.
WA_AUTOREPLY_MS=3000

# Después de cuántos minutos sin actividad en un chat donde estaba el
# asesor, el bot manda "¿te puedo ayudar en algo más?" y vuelve a actuar.
# Default 60 minutos (1 hora).
WA_FOLLOWUP_MINUTES=60

# --- Google Contactos (agenda automática de clientes/mayoristas/proveedores) ---
# El bot agenda solo el contacto en Google Contactos cuando detecta la categoría.
# Estos 3 valores salen de autorizar Google en el panel (/conexiones -> Google
# Contactos -> "Autorizar Google"): la pantalla verde muestra las 3 líneas listas
# para copiar. Autorizá con la cuenta donde querés la agenda (redes@uniproveedores.com.ar).
# Si faltan, el bot NO agenda (sigue funcionando igual el resto).
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REFRESH_TOKEN=
